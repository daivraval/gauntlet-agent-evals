# Copy this file to .env and fill in one provider.
# GAUNTLET talks to any OpenAI-compatible endpoint — pick one preset below.

# ── Groq (recommended: free tier, fast, solid tool calling) ─────────────────
GAUNTLET_BASE_URL="https://api.groq.com/openai/v1"
GAUNTLET_API_KEY="your-groq-key-here"          # https://console.groq.com
GAUNTLET_AGENT_MODEL="llama-3.3-70b-versatile"
GAUNTLET_JUDGE_MODEL="llama-3.3-70b-versatile"

# ── OpenAI ───────────────────────────────────────────────────────────────────
# GAUNTLET_BASE_URL="https://api.openai.com/v1"
# GAUNTLET_API_KEY="sk-..."
# GAUNTLET_AGENT_MODEL="gpt-4o-mini"
# GAUNTLET_JUDGE_MODEL="gpt-4o-mini"

# ── Hugging Face router (works with your existing HF_TOKEN) ─────────────────
# GAUNTLET_BASE_URL="https://router.huggingface.co/v1"
# GAUNTLET_API_KEY="hf_..."
# GAUNTLET_AGENT_MODEL="Qwen/Qwen2.5-72B-Instruct"

# ── Ollama (fully local, free) ───────────────────────────────────────────────
# GAUNTLET_BASE_URL="http://localhost:11434/v1"
# GAUNTLET_API_KEY="ollama"
# GAUNTLET_AGENT_MODEL="qwen2.5:7b"

# ── Optional ─────────────────────────────────────────────────────────────────
# GAUNTLET_TEMPERATURE=0
# GAUNTLET_PASS_THRESHOLD=0.7
# $ per 1M tokens — set these to get a cost column in reports
# GAUNTLET_PRICE_INPUT_PER_1M=0
# GAUNTLET_PRICE_OUTPUT_PER_1M=0
